{
  "uid": "securelife-agent-metrics",
  "title": "SecureLife Insurance Agent - Metrics",
  "tags": ["securelife", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Support turns completed / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "securelife-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "securelife-prometheus" },
          "expr": "sum(rate(securelife_agent_requests_total[1m])) * 60",
          "legendFormat": "turns/min"
        }
      ]
    },
    {
      "id": 2,
      "title": "Turns by resolved intent",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "securelife-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "securelife-prometheus" },
          "expr": "sum by (intent) (securelife_agent_requests_total)",
          "legendFormat": "{{intent}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 node latency (by LangGraph node)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "securelife-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "securelife-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, node) (rate(securelife_agent_node_duration_seconds_bucket[1m])))",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "p95 full turn latency",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "securelife-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "securelife-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(securelife_agent_turn_duration_seconds_bucket[1m])))"
        }
      ]
    },
    {
      "id": 5,
      "title": "Node errors (5m)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "securelife-prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "securelife-prometheus" },
          "expr": "sum(increase(securelife_agent_node_errors_total[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "title": "LLM token usage rate (by node, direction)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "securelife-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "securelife-prometheus" },
          "expr": "sum by (node, token_type) (rate(securelife_agent_llm_tokens_total[1m]))",
          "legendFormat": "{{node}} / {{token_type}}"
        }
      ]
    }
  ]
}
