{
  "name": "15_6 AI Support Desk",
  "nodes": [
    {
      "parameters": {
        "content": "## 15_6 AI Support Desk\n**Setup**\n1. Load `15_schema.sql`; import and **activate** the Customer Lookup API helper.\n2. Pick credentials: OpenAI, MySQL, Gmail, Google Sheets.\n3. Create a tab **Ticket Log** with headers: time, ticket_id, category, priority, reply_sent.\n4. Change the support lead address in **Alert Support Lead** (support-team@example.com).\n5. After importing 15_7: Workflow **Settings → Error workflow → 15_7**.",
        "width": 520,
        "height": 300,
        "color": 5
      },
      "id": "3321a7c3-94b3-4717-b22b-c0a806dca9b1",
      "name": "Note 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -440
      ]
    },
    {
      "parameters": {
        "formTitle": "Contact Support",
        "formDescription": "We usually reply within a few hours.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "requiredField": true,
              "fieldType": "email"
            },
            {
              "fieldLabel": "Order number",
              "requiredField": false,
              "placeholder": "Optional"
            },
            {
              "fieldLabel": "Message",
              "requiredField": true,
              "fieldType": "textarea"
            }
          ]
        },
        "options": {
          "path": "support",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Thanks! We have received your request and will email you shortly."
            }
          }
        }
      },
      "id": "40921b2f-7561-41d1-8dd9-8a141840e5d3",
      "name": "Form Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "webhookId": "3faf2dd3-bcef-4fb3-b2ad-3dfcb63550aa"
    },
    {
      "parameters": {
        "url": "http://localhost:5678/webhook/customer",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{ $json.Email }}"
            }
          ]
        },
        "options": {}
      },
      "id": "c6650e05-a20d-4e31-b06e-ad3a545eb990",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer name: {{ $('Form Trigger').item.json.Name }}\nCustomer tier: {{ $json.tier }}\nOrder number: {{ $('Form Trigger').item.json['Order number'] || 'not given' }}\n\nMessage:\n{{ $('Form Trigger').item.json.Message }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are the support triage assistant for an online electronics store. Read the customer's message and return: category (one of Billing, Technical, Delivery, General); priority (Low, Medium or High; High = money lost, service down, or a very upset customer); summary (max 12 words); reply (polite, max 80 words, greet the customer by first name, do not promise refunds, amounts or dates)."
            }
          ]
        }
      },
      "id": "01c8c695-57dd-436d-9747-7250bed9303f",
      "name": "Classify & Draft Reply",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "id": "ee3c68ab-2862-4567-aa3b-fe81c5ef0f83",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        420,
        240
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"category\": \"Billing\",\n  \"priority\": \"High\",\n  \"summary\": \"Charged twice for September plan\",\n  \"reply\": \"Dear Asha, ...\"\n}"
      },
