    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet nextNumber = 1;\n\nif (items.length > 0) {\n  const claimIds = items\n    .map(item => item.json.claim_id)\n    .filter(id => id && /^CLM\\d+$/.test(id))\n    .map(id => parseInt(id.replace(\"CLM\", \"\"), 10));\n\n  if (claimIds.length > 0) {\n    nextNumber = Math.max(...claimIds) + 1;\n  }\n}\n\nconst claimId = \"CLM\" + String(nextNumber).padStart(3, \"0\");\n\nreturn [\n  {\n    json: {\n      claim_id: claimId\n    }\n  }\n];"
      },
