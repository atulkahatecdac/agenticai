    {
      "parameters": {
        "jsCode": "const item = $input.first();\n\n// Get original email directly from Gmail Trigger\nconst email = $(\"Gmail Trigger\").first().json;\n\nconst from = email.From || \"\";\nconst subject = email.Subject || \"\";\nconst message = email.snippet || \"\";\n\n// Extract email address from:\n// newdelthis newdelthis <newdelthis@gmail.com>\nconst match = from.match(/<([^>]+)>/);\n\nconst customer_email = match ? match[1] : from;\n\nconst output = [];\n\nfor (const [key, value] of Object.entries(item.binary || {})) {\n\n  output.push({\n    json: {\n      customer_email: customer_email,\n      customer_name: from.replace(/<[^>]+>/, \"\").trim(),\n      subject: subject,\n      message: message,\n      filename: value.fileName,\n      mimeType: value.mimeType\n    },\n\n    binary: {\n      data: value\n    }\n  });\n\n}\n\nreturn output;"
      },
