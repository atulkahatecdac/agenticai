# Copy this file to .env in this folder and fill in your own values.
# .env is git-ignored: never commit it and never copy it into a Docker image.

# Your OpenAI key (chat model and embeddings)
OPENAI_API_KEY=

# Password for the Postgres container (choose any password)
POSTGRES_PASSWORD=docassist123

# Where the Python code finds Postgres.
# On your laptop (steps 02-07) Postgres is published on port 5433.
# Inside Docker Compose the backend uses db:5432 instead (set in docker-compose.yml).
DATABASE_URL=postgresql://postgres:docassist123@localhost:5433/docassist
