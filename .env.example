# Copy this file to .env (in the repo root) and fill in the keys you need.
#   cp .env.example .env        (macOS/Linux/Git Bash)
#   copy .env.example .env      (Windows cmd/PowerShell)
#
# You do NOT need every key. Most demos need only OPENAI_API_KEY; the others
# are used by individual scripts (named next to each group below). A script
# that needs a missing key will fail with an auth error or an explicit
# "missing ... key" message.
#
# Scripts load this file with load_dotenv(override=True), so values here win
# over variables already set in your shell.
#
# AWS Bedrock (8_bedrock) is NOT configured here: boto3 uses your normal AWS
# credentials (aws configure / AWS_PROFILE). Google ADK agents (11_google_adk)
# each have their own .env.example in their folder.

# --- LLM providers -----------------------------------------------------------
# almost everything
OPENAI_API_KEY=
# Claude examples, 3_langgraph guardrails demos
ANTHROPIC_API_KEY=
# Gemini via LangChain / google-genai
GOOGLE_API_KEY=
# a few Gemini/DSPy scripts read this name instead
GEMINI_API_KEY=
# Groq-hosted models (CrewAI, LangChain)
GROQ_API_KEY=
# Cohere RAG / reranking
COHERE_API_KEY=
PERPLEXITY_API_KEY=
# 15_real/huggingface_basic_agent.py
HUGGINGFACEHUB_API_TOKEN=
# OLLAMA_HOST=http://localhost:11434   # only if Ollama isn't on the default host

# --- Search / web / data tools -----------------------------------------------
TAVILY_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=
EXA_API_KEY=
NEWS_API_KEY=
MARKETAUX_API_KEY=
FRED_API_KEY=
WEATHER_API_KEY=
EXCHANGE_RATE_API_KEY=
IPINFO_TOKEN=
IPINFO_API_TOKEN=
IP2LOCATION_API_KEY=
# 6_mcp Indian jobs server
INDIAN_JOBS_API_KEY=
# For 15_real/llamaparse_ocr.py - free key at https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=

# --- Vector databases --------------------------------------------------------
PINECONE_API_KEY=
# only for older Pinecone examples
PINECONE_ENVIRONMENT=
# 7_n8n Qdrant scripts
QDRANT_URL_ENDPOINT=
QDRANT_API_KEY=

# --- Notifications / email ---------------------------------------------------
MAILERSEND_API_KEY=
GMAIL_APP_PASSWORD=
# pick a hard-to-guess topic name; ntfy topics are public
NTFY_TOPIC=
NTFY_URGENT_TICKETS_TOPIC=

# --- MCP / integrations ------------------------------------------------------
ZAPIER_KEY=
CODERABBIT_API_KEY=

# 6_mcp/authentication (version_2 static token, version_3 Scalekit OAuth2)
MCP_ACCESS_TOKEN=
MCP_URL=
SCALEKIT_ENVIRONMENT_URL=
SCALEKIT_CLIENT_ID=
SCALEKIT_RESOURCE_ID=

# GitHub MCP (official github/github-mcp-server, used by 6_mcp/6_15 and 6_16) -
# deliberately a SEPARATE, disposable GitHub account/repo, not your main one.
GITHUB_READONLY_TOKEN=
GITHUB_WRITE_TOKEN=
GITHUB_DEMO_OWNER=
GITHUB_DEMO_REPO=

# --- Observability -----------------------------------------------------------
# LangSmith (9_general, 14_advanced/09_langsmith, 15_real)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Langfuse (9_general, 15_real)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
